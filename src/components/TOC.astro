---
export interface Props {
  content: {
    headings?: Array<{ depth: number; slug: string; text: string }>;
  };
}

const { content } = Astro.props;
const headings = content?.headings?.filter(h => h.depth >= 2 && h.depth <= 3) || [];
---

{
  headings.length > 0 && (
    <div class="card p-5 mb-8">
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-poe-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
        </svg>
        <h2 class="font-orbitron text-base font-bold text-white">
          Table of Contents
        </h2>
      </div>
      <nav>
        <ul class="space-y-1">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class={`
                  block py-1.5 text-sm transition-colors duration-200 rounded hover:bg-poe-primary/5
                  ${heading.depth === 2
                    ? 'pl-0 text-poe-text-secondary hover:text-poe-primary'
                    : 'pl-4 text-poe-text-secondary/70 hover:text-poe-text-secondary'
                  }
                `}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}
