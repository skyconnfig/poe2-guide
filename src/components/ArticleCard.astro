---
export interface Props {
  title: string;
  description: string;
  href: string;
  date: string;
  author: string;
  category: string;
  tags?: string[];
  type?: "build" | "guide";
}

const { title, description, href, date, author, category, tags = [], type = "build" } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const isBuild = type === "build";
---

<a href={href} class="card-hover block group">
  <div class="p-5">
    <!-- Category -->
    <div class="flex items-center justify-between mb-3">
      <span class={`text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full ${isBuild ? "text-poe-primary bg-poe-primary/10" : "text-poe-accent bg-poe-accent/10"}`}>
        {category}
      </span>
      <time class="text-xs text-poe-text-secondary/60">{formattedDate}</time>
    </div>

    <!-- Title -->
    <h3 class={`text-lg font-bold text-white mb-2 line-clamp-2 transition-colors ${isBuild ? "group-hover:text-poe-primary" : "group-hover:text-poe-accent"}`}>
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-poe-text-secondary leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Tags (guides only) -->
    {!isBuild && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-poe-card/50 text-poe-text-secondary/70">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Footer -->
    <div class="flex items-center justify-between pt-4 border-t border-poe-border/20">
      <span class="text-xs text-poe-text-secondary/60">By {author}</span>
      <span class={`text-xs group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 ${isBuild ? "text-poe-primary" : "text-poe-accent"}`}>
        Read {isBuild ? "Build" : "Guide"}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </div>
</a>
